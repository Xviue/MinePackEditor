<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MinePackEditor.Controls.TemplatedControls">
    <Design.PreviewWith>
        <!-- 父容器必须关闭裁剪，否则滑出部分被裁 -->
        <Grid ClipToBounds="False" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20">
            <local:SlideTipBar x:Name="TipBar" BarId="Test">
                <local:SlideTip Id="save" Content="保存成功" SlideDirection="Left" />
                <local:SlideTip Id="delete" Content="删除成功" SlideDirection="Left" />
                <local:SlideTip Id="sync" Content="同步完成" SlideDirection="Left" EnterDuration="0:0:0.5" />
            </local:SlideTipBar>
        </Grid>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type local:SlideTipBar}" TargetType="local:SlideTipBar">
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Template">
                <ControlTemplate TargetType="local:SlideTipBar">
                    <Canvas x:Name="PART_Host" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

</Styles>