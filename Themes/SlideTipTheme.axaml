<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MinePackEditor.Controls.TemplatedControls">

    <Design.PreviewWith>
        <!-- 父容器必须关闭裁剪，否则滑出外部会被裁掉 -->
        <Grid ClipToBounds="True" Margin="20">
            <local:SlideTip IsOpen="True" EnterDuration="0:0:3" SlideDirection="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource SomeCheckIcon}" Foreground="White" Width="16" Height="16"/>
                    <TextBlock Text="文件保存成功" VerticalAlignment="Center"/>
                </StackPanel>
            </local:SlideTip>
        </Grid>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="{x:Type local:SlideTip}" TargetType="local:SlideTip">
            <Setter Property="Background" Value="#CC333333" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />

            <Setter Property="Template">
                <ControlTemplate TargetType="local:SlideTip">
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            MaxWidth="{TemplateBinding MaxWidth}"
                            BoxShadow="0 4 12 0 #66000000">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center">
                            <ContentPresenter.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </ContentPresenter.Styles>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

</Styles>