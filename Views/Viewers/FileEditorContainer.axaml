<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:MinePackEditor.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MinePackEditor.Views.FileEditorContainer">
  <Grid>
        <!-- 实际编辑器挂载点 -->
        <ContentControl x:Name="EditorHost" />

        <!-- 加载遮罩：绑定 FileDocument.IsLoading -->
        <Border Background="#EEEEEE"
                x:DataType="models:FileDocument"
                IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             CornerRadius="2" />
                <TextBlock Text="{Binding LoadingProgress}"
                           Foreground="Black"
                           FontSize="13"
                           HorizontalAlignment="Center" />
                <TextBlock Text="正在加载..."
                           Foreground="Black"
                           FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
