<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:settings="using:MinePackEditor.Models.Settings">
    <Design.PreviewWith>
        <StackPanel Width="400">
            <Slider Value="0.2"
                    Minimum="0"
                    Maximum="1"
                    TickFrequency="0.1"
                    IsSnapToTickEnabled="True" />
            <TextBlock Text="当前的值"
                       HorizontalAlignment="Right"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
    </Design.PreviewWith>
    
    <DataTemplate x:Key="SliderEditor" DataType="settings:SettingItem">
        <StackPanel>
            <Slider Value="{Binding DoubleValue, Mode=TwoWay}"
                    Minimum="{Binding MinValue}"
                    Maximum="{Binding MaxValue}"
                    TickFrequency="{Binding StepValue}"
                    IsSnapToTickEnabled="True" />
            <TextBlock Text="{Binding DoubleValue, StringFormat='{}{0:F2}'}"
                       HorizontalAlignment="Right"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>