<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:designs="using:MinePackEditor.Designs"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:selectors="using:MinePackEditor.Selectors"
             xmlns:settings="using:MinePackEditor.Models.Settings"
             xmlns:uiloc="using:MinePackEditor.Localization.UI"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="150"
             x:Class="MinePackEditor.Controls.UserControls.SettingItemControl"
             x:DataType="settings:SettingItem">
    <Design.DataContext>
        <x:Static Member="designs:DesignTimeSettingItem.ComboExample" />
    </Design.DataContext>

    <UserControl.Resources>
        <ControlTheme TargetType="Border" x:Key="MarkedBorder">
            <Setter Property="Background" Value="Transparent" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource BgInBrush}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <Border Background="{DynamicResource BackgroundBrush}">
        <Border Margin="0,6,0,0" Padding="14,12"
                CornerRadius="8" Theme="{StaticResource MarkedBorder}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Border.Transitions>
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                <!-- 标题与描述 -->
                <StackPanel Grid.Row="0">
                    <Panel >
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{uiloc:Loc Key=Setting-Modified}"
                                       FontSize="10"
                                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                       VerticalAlignment="Top"
                                       IsVisible="{Binding IsModified}" />
                            <TextBlock Text="{Binding DisplayNameKey, Converter={StaticResource ConfigLocConverter}}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Id}" FontSize="12" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    </Panel>
                    <TextBlock Text="{Binding DescriptionKey, Converter={StaticResource ConfigLocConverter}}"
                               FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding DescriptionKey, Converter={StaticResource NullToVisConv}}" />
                </StackPanel>

                <!-- 动态编辑器：引用全局的 EditorSelector -->
                <ContentControl Grid.Row="1"
                                Content="{Binding .}"
                                ContentTemplate="{StaticResource EditorSelector}" />

                <!-- 默认值提示 -->
                <TextBlock Grid.Row="2"
                           Text="{Binding DefaultValue, Converter={StaticResource DefaultValueStringConv}}"
                           FontSize="10"
                           Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                           IsVisible="{Binding DefaultValue, Converter={StaticResource NullToVisConv}}" />
            </Grid>
        </Border>
    </Border>
</UserControl>
